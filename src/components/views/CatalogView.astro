---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import ProductCard from '~/components/catalog/ProductCard.astro';
import CustomCard from '~/components/catalog/CustomCard.astro';
import { useTranslations } from '~/i18n/utils';
import { type Lang, categories, productsInCategory, categoryPath } from '~/data/products';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const metadata = { title: t('catalog.title'), description: t('catalog.description') };
---

<Layout metadata={metadata}>
  <Hero>
    <Fragment slot="title">{t('catalog.title')}</Fragment>
    <Fragment slot="subtitle">{t('catalog.intro')}</Fragment>
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-gradient-to-b from-primary/10 to-transparent dark:from-primary/20"></div>
    </Fragment>
  </Hero>

  {
    categories.map((category) => (
      <section id={category.id} class="py-10 md:py-14 bg-white dark:bg-slate-900 scroll-mt-20">
        <div class="max-w-7xl mx-auto px-4 sm:px-6">
          <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-2 mb-6">
            <div>
              <h2 class="text-2xl md:text-3xl font-bold text-gray-900 dark:text-gray-100">{category.name[lang]}</h2>
              <p class="text-gray-600 dark:text-gray-400 mt-1">{category.tagline[lang]}</p>
            </div>
            <a href={categoryPath(category.id, lang)} class="font-semibold text-primary hover:underline">
              {category.seeAll[lang]}
            </a>
          </div>
          <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6">
            {productsInCategory(category.id).map((product) => (
              <ProductCard product={product} lang={lang} />
            ))}
          </div>
        </div>
      </section>
    ))
  }

  <section class="pt-4 pb-16 md:pb-20 bg-white dark:bg-slate-900">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <CustomCard lang={lang} />
    </div>
  </section>
</Layout>
