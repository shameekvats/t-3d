---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Layout from '~/layouts/PageLayout.astro';
import ProductCard from '~/components/catalog/ProductCard.astro';
import PhotoComingSoon from '~/components/PhotoComingSoon.astro';
import ProductSchema from '~/components/common/ProductSchema.astro';
import { findImage } from '~/utils/images';
import { getLocalizedUrl, useTranslations } from '~/i18n/utils';
import {
  type Lang,
  type Product,
  getAddon,
  getCategory,
  productsInCategory,
  priceLabel,
  priceNote,
  formatPrice,
  needsPhoto,
  photoTip,
  imageAlt,
  categoryPath,
  orderPath,
} from '~/data/products';

interface Props {
  product: Product;
  lang: Lang;
}

const { product, lang } = Astro.props;
const t = useTranslations(lang);
const category = getCategory(product.category!)!;
const images = (
  await Promise.all(product.images.map(async (ref) => ({ ...ref, meta: (await findImage(ref.src)) as ImageMetadata | undefined })))
).filter((img) => img.meta);
const [mainImage, ...moreImages] = images;
const productAddons = product.addons.map((id) => getAddon(id)!).filter(Boolean);
const related = productsInCategory(category.id).filter((p) => p.id !== product.id);
const note = priceNote(product, lang);

const metadata = {
  title: product.name[lang],
  description: `${product.shortDescription[lang]} ${priceLabel(product, lang)}${t('product.metaSuffix')}`,
  ...(product.images[0] ? { openGraph: { images: [{ url: product.images[0].src }] } } : {}),
};
---

<Layout metadata={metadata}>
  <ProductSchema products={[product]} lang={lang} />
  <section class="pt-24 pb-12 bg-gradient-to-b from-primary/10 to-transparent dark:from-primary/20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <nav class="mb-6 text-sm" aria-label="Breadcrumb">
        <a href={getLocalizedUrl('/', lang)} class="text-gray-600 dark:text-gray-400 hover:text-primary">{t('nav.home')}</a>
        <span class="mx-2 text-gray-400">/</span>
        <a href={getLocalizedUrl('/catalog', lang)} class="text-gray-600 dark:text-gray-400 hover:text-primary">{t('nav.catalog')}</a>
        <span class="mx-2 text-gray-400">/</span>
        <a href={categoryPath(category.id, lang)} class="text-gray-600 dark:text-gray-400 hover:text-primary">{category.name[lang]}</a>
        <span class="mx-2 text-gray-400">/</span>
        <span class="text-gray-900 dark:text-gray-100 font-semibold">{product.name[lang]}</span>
      </nav>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-start">
        <!-- Photos -->
        <div>
          <div class="aspect-square rounded-2xl overflow-hidden bg-gray-100 dark:bg-slate-700 shadow-lg">
            {
              mainImage ? (
                <Image
                  src={mainImage.meta!}
                  alt={imageAlt(mainImage, lang, product.name)}
                  class="w-full h-full object-cover"
                  widths={[400, 768, 1024]}
                  sizes="(max-width: 1024px) 100vw, 600px"
                  loading="eager"
                />
              ) : (
                <PhotoComingSoon class="aspect-square" />
              )
            }
          </div>
          {
            moreImages.length > 0 && (
              <div class="grid grid-cols-3 sm:grid-cols-4 gap-3 mt-3">
                {moreImages.map((img) => (
                  <div class="aspect-square rounded-lg overflow-hidden bg-gray-100 dark:bg-slate-700">
                    <Image
                      src={img.meta!}
                      alt={imageAlt(img, lang, product.name)}
                      class="w-full h-full object-cover"
                      widths={[200, 400]}
                      sizes="(max-width: 640px) 33vw, 150px"
                    />
                  </div>
                ))}
              </div>
            )
          }
        </div>

        <!-- Details -->
        <div class="bg-white dark:bg-slate-800 rounded-2xl shadow-xl p-6 sm:p-8 border border-gray-100 dark:border-slate-700">
          <h1 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-gray-100">{product.name[lang]}</h1>
          <p class="mt-3 text-3xl font-bold text-primary">{priceLabel(product, lang)}</p>
          {note && <p class="text-sm text-gray-500 dark:text-gray-400">{note}</p>}
          <p class="mt-4 text-lg text-gray-600 dark:text-gray-400">{product.shortDescription[lang]}</p>

          {
            product.options.length > 0 && (
              <div class="mt-6">
                <h2 class="text-xs font-semibold uppercase tracking-widest text-gray-500 dark:text-gray-400 mb-2">{t('product.youChoose')}</h2>
                <ul class="space-y-2">
                  {product.options.map((option) => (
                    <li class="px-4 py-2.5 bg-gray-50 dark:bg-slate-700/50 rounded-lg text-sm font-medium text-gray-700 dark:text-gray-300">
                      {option[lang]}
                    </li>
                  ))}
                </ul>
              </div>
            )
          }

          {
            productAddons.length > 0 && (
              <div class="mt-6">
                <h2 class="text-xs font-semibold uppercase tracking-widest text-gray-500 dark:text-gray-400 mb-2">{t('product.addons')}</h2>
                <ul class="space-y-2">
                  {productAddons.map((addon) => (
                    <li class="px-4 py-2.5 bg-primary/5 dark:bg-primary/10 border border-primary/20 rounded-lg">
                      <div class="flex items-baseline justify-between gap-4 text-sm font-medium text-gray-700 dark:text-gray-300">
                        <span>{addon.name[lang]}</span>
                        <span class="whitespace-nowrap">+{formatPrice(addon.price, lang)}</span>
                      </div>
                      {addon.description && <p class="mt-1 text-xs text-gray-600 dark:text-gray-400">{addon.description[lang]}</p>}
                    </li>
                  ))}
                </ul>
              </div>
            )
          }

          {
            needsPhoto(product) && (
              <p class="mt-6 bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-700/50 rounded-lg p-3 text-xs text-amber-800 dark:text-amber-300">
                {photoTip[lang]}
              </p>
            )
          }

          <a
            href={orderPath(product, lang)}
            class="mt-8 block w-full text-center bg-primary hover:bg-primary-dark text-white font-bold py-4 px-8 rounded-lg transition-colors duration-300"
          >
            {t('product.orderThis')}
          </a>
          <p class="mt-3 text-center text-sm text-gray-500 dark:text-gray-400">{t('product.note')}</p>
        </div>
      </div>
    </div>
  </section>

  {
    related.length > 0 && (
      <section class="py-12 md:py-16 bg-white dark:bg-slate-900">
        <div class="max-w-7xl mx-auto px-4 sm:px-6">
          <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-6">{category.more[lang]}</h2>
          <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6">
            {related.map((p) => <ProductCard product={p} lang={lang} />)}
          </div>
        </div>
      </section>
    )
  }
</Layout>
