---
import Layout from '~/layouts/PageLayout.astro';
import { getLocalizedUrl, useTranslations } from '~/i18n/utils';
import type { Lang, UiKey } from '~/i18n/translations';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const metadata = { title: t('thanks.title'), description: t('thanks.description'), robots: { index: false, follow: true } };
const steps = [1, 2, 3].map((n) => ({
  title: t(`thanks.step${n}.title` as UiKey),
  text: t(`thanks.step${n}.text` as UiKey),
}));
---

<Layout metadata={metadata}>
  <section class="py-20 md:py-32 bg-gradient-to-br from-white to-gray-50 dark:from-slate-900 dark:to-slate-800">
    <div class="max-w-2xl mx-auto px-4 sm:px-6 text-center">
      <div class="mb-8 w-24 h-24 mx-auto bg-green-100 dark:bg-green-900/30 rounded-full flex items-center justify-center">
        <svg class="w-12 h-12 text-green-600 dark:text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
        </svg>
      </div>
      <h1 class="text-4xl md:text-5xl font-bold mb-6 text-gray-900 dark:text-gray-100">{t('thanks.heading')}</h1>
      <p class="text-xl text-gray-600 dark:text-gray-300 mb-10">{t('thanks.message')}</p>

      <div class="bg-white dark:bg-slate-800 rounded-xl shadow-lg p-6 sm:p-8 text-left mb-8">
        <h2 class="text-2xl font-semibold mb-6 text-gray-900 dark:text-gray-100 text-center">{t('thanks.nextTitle')}</h2>
        <ol class="space-y-4">
          {
            steps.map((step, i) => (
              <li class="flex items-start gap-4">
                <span class="flex-shrink-0 w-8 h-8 bg-primary/10 rounded-full flex items-center justify-center text-primary font-semibold">
                  {i + 1}
                </span>
                <div>
                  <h3 class="font-semibold text-gray-900 dark:text-gray-100 mb-1">{step.title}</h3>
                  <p class="text-gray-600 dark:text-gray-400">{step.text}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>

      <div class="mb-10 p-5 bg-blue-50 dark:bg-blue-900/20 border-l-4 border-blue-500 rounded-lg text-left">
        <h3 class="font-semibold text-blue-900 dark:text-blue-300 mb-1">{t('thanks.filesTitle')}</h3>
        <p class="text-blue-800 dark:text-blue-200">{t('thanks.filesText')}</p>
      </div>

      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href={getLocalizedUrl('/', lang)}
          class="inline-flex items-center justify-center px-8 py-3 rounded-lg bg-primary hover:bg-primary-dark text-white font-semibold transition-colors"
          >{t('thanks.home')}</a
        >
        <a
          href={getLocalizedUrl('/catalog', lang)}
          class="inline-flex items-center justify-center px-8 py-3 rounded-lg bg-gray-200 hover:bg-gray-300 dark:bg-slate-700 dark:hover:bg-slate-600 text-gray-900 dark:text-gray-100 font-semibold transition-colors"
          >{t('thanks.products')}</a
        >
      </div>
    </div>
  </section>
</Layout>
