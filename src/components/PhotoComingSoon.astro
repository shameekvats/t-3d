---
import { getLangFromUrl, useTranslations } from '~/i18n/utils';

interface Props {
  label?: string;
  class?: string;
}

const t = useTranslations(getLangFromUrl(Astro.url));
const { label = t('common.photoComingSoon'), class: className = '' } = Astro.props;
---

<div
  class={`flex flex-col items-center justify-center gap-3 w-full h-full min-h-[12rem] bg-gradient-to-br from-primary/10 to-secondary/10 dark:from-primary/20 dark:to-secondary/20 text-gray-500 dark:text-gray-400 ${className}`}
  role="img"
  aria-label={label}
>
  <svg class="w-12 h-12 opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" />
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z" />
  </svg>
  <span class="text-sm font-medium tracking-wide">{label}</span>
</div>
