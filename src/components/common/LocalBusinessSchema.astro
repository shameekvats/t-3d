---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { findImage } from '~/utils/images';
import { catalogProducts, currency, productPath } from '~/data/products';
import { getLangFromUrl, getLocalizedUrl, useTranslations } from '~/i18n/utils';

// LocalBusiness JSON-LD, generated from products.ts so prices stay in sync.
const site = Astro.site?.toString().replace(/\/$/, '') ?? 'https://t-3d.me';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const prices = catalogProducts().flatMap((p) => (p.price === null ? [] : [p.price]));
const ogDefault = (await findImage('~/assets/images/og-default.jpg')) as ImageMetadata;
const image = await getImage({ src: ogDefault, format: 'jpg' });

const schema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': `${site}/#business`,
  name: 'tattva-3d',
  description: t('schema.businessDescription'),
  url: lang === 'en' ? `${site}/` : `${site}${getLocalizedUrl('/', lang)}`,
  email: 't-3d@ik.me',
  image: new URL(image.src, site).toString(),
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Aalborg',
    addressCountry: 'DK',
  },
  areaServed: 'Aalborg',
  priceRange: `${Math.min(...prices)}–${Math.max(...prices)} kr`,
  currenciesAccepted: currency,
  paymentAccepted: 'MobilePay, Cash',
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Personal 3D printed gifts',
    itemListElement: catalogProducts().map((p) => ({
      '@type': 'Offer',
      price: p.price,
      priceCurrency: currency,
      url: `${site}${productPath(p, lang)}`,
      itemOffered: { '@type': 'Product', name: p.name[lang], description: p.shortDescription[lang] },
    })),
  },
  sameAs: ['https://www.instagram.com/tattva_3d/'],
};
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
