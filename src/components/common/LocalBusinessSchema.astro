---
import { getImage } from 'astro:assets';
import ogDefault from '~/assets/images/og-default.jpg';
import { catalogProducts, currency, productPath } from '~/data/products';

// LocalBusiness JSON-LD, generated from products.ts so prices stay in sync.
const site = Astro.site?.toString().replace(/\/$/, '') ?? 'https://t-3d.me';
const prices = catalogProducts().flatMap((p) => (p.price === null ? [] : [p.price]));
const image = await getImage({ src: ogDefault, format: 'jpg' });

const schema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': `${site}/#business`,
  name: 'tattva-3d',
  description: 'Personal 3D printed gifts made to order in Aalborg, Denmark: photo gifts, 3D maps, lamps and lightboxes.',
  url: `${site}/`,
  email: 't-3d@ik.me',
  image: new URL(image.src, site).toString(),
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Aalborg',
    addressCountry: 'DK',
  },
  areaServed: 'Aalborg',
  priceRange: `${Math.min(...prices)}–${Math.max(...prices)} kr`,
  currenciesAccepted: currency,
  paymentAccepted: 'MobilePay, Cash',
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Personal 3D printed gifts',
    itemListElement: catalogProducts().map((p) => ({
      '@type': 'Offer',
      price: p.price,
      priceCurrency: currency,
      url: `${site}${productPath(p)}`,
      itemOffered: { '@type': 'Product', name: p.name, description: p.shortDescription },
    })),
  },
  sameAs: ['https://www.instagram.com/tattva_3d/'],
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
