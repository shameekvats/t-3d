---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { findImage } from '~/utils/images';
import { currency, productPath, type Lang, type Product } from '~/data/products';

// Product + Offer JSON-LD generated from products.ts. One product -> Product; several -> ItemList.
interface Props {
  products: Product[];
  lang: Lang;
}

const { products, lang } = Astro.props;
const site = Astro.site?.toString().replace(/\/$/, '') ?? 'https://t-3d.me';

const toProduct = async (p: Product) => {
  const images = await Promise.all(
    p.images.slice(0, 3).map(async (ref) => {
      const meta = (await findImage(ref.src)) as ImageMetadata | undefined;
      return meta ? new URL((await getImage({ src: meta, width: 1200, format: 'jpg' })).src, site).toString() : undefined;
    })
  );
  const url = `${site}${productPath(p, lang)}`;
  return {
    '@type': 'Product',
    '@id': `${url}#product`,
    name: p.name[lang],
    description: p.shortDescription[lang],
    sku: p.id,
    url,
    ...(images.some(Boolean) ? { image: images.filter(Boolean) } : {}),
    brand: { '@type': 'Brand', name: 'tattva-3d' },
    ...(p.price === null
      ? {}
      : {
          offers: {
            '@type': 'Offer',
            price: p.price,
            priceCurrency: currency,
            availability: p.available ? 'https://schema.org/InStock' : 'https://schema.org/OutOfStock',
            url,
            seller: { '@id': `${site}/#business` },
          },
        }),
  };
};

const items = await Promise.all(products.map(toProduct));
const schema =
  items.length === 1
    ? { '@context': 'https://schema.org', ...items[0] }
    : {
        '@context': 'https://schema.org',
        '@type': 'ItemList',
        itemListElement: items.map((item, i) => ({ '@type': 'ListItem', position: i + 1, item })),
      };
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
