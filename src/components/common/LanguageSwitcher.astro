---
import { getLangFromUrl, getLanguageUrls, useTranslations } from '~/i18n/utils';
import type { Lang } from '~/i18n/translations';

const current = getLangFromUrl(Astro.url);
const urls = getLanguageUrls(Astro.url);
const t = useTranslations(current);
const options: { lang: Lang; label: string }[] = [
  { lang: 'en', label: 'EN' },
  { lang: 'da', label: 'DA' },
];
---

<nav class="flex items-center text-sm font-semibold border border-gray-300 dark:border-gray-600 rounded-lg overflow-hidden" aria-label={t('ui.switchLanguage')}>
  {
    options.map(({ lang, label }) => (
      <a
        href={urls[lang]}
        hreflang={lang}
        lang={lang}
        aria-current={lang === current ? 'true' : undefined}
        class:list={[
          'px-2.5 py-1 transition-colors',
          lang === current
            ? 'bg-primary text-white cursor-default pointer-events-none'
            : 'text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700',
        ]}
      >
        {label}
      </a>
    ))
  }
</nav>
