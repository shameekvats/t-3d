---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Layout from '~/layouts/PageLayout.astro';
import { findImage } from '~/utils/images';
import { getPermalink } from '~/utils/permalinks';
import { getProduct, orderPath } from '~/data/products';

const custom = getProduct('custom')!;
const examples = (
  await Promise.all(custom.images.map(async (ref) => ({ ...ref, meta: (await findImage(ref.src)) as ImageMetadata | undefined })))
).filter((img) => img.meta);

const metadata = {
  title: 'Custom & business orders',
  description:
    'Branded keychains, logo lightboxes, logo magnets, large multi-tile maps and workshops. Tell us your idea and get a quote from tattva-3d in Aalborg.',
  openGraph: { images: [{ url: custom.images[0].src }] },
};

const ideas = [
  { title: 'Branded keychains', text: 'Your logo or club badge on keychains, with an optional NFC tag that opens your website.' },
  { title: 'Logo lightboxes', text: 'Your logo or name glowing on a desk, counter or shelf.' },
  { title: 'Logo magnets', text: 'Small runs of fridge magnets for events, teams and shops.' },
  { title: 'Large multi-tile maps', text: 'Maps bigger than one print, joined from several tiles.' },
  { title: 'Workshops', text: 'Hands-on sessions where your group designs and prints its own pieces.' },
];

const steps = [
  { title: 'Tell us your idea', text: 'Send a short description, a logo or a sketch, and how many you need.' },
  { title: 'Get a quote and a preview', text: 'We reply by email with a price and a preview before anything is printed.' },
  { title: 'Pick up in Aalborg', text: 'Collect your order and pay with MobilePay or cash.' },
];
---

<Layout metadata={metadata}>
  <section class="pt-24 pb-10 bg-gradient-to-b from-primary/10 to-transparent dark:from-primary/20">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">
      <nav class="mb-6 text-sm" aria-label="Breadcrumb">
        <a href={getPermalink('/')} class="text-gray-600 dark:text-gray-400 hover:text-primary">Home</a>
        <span class="mx-2 text-gray-400">/</span>
        <span class="text-gray-900 dark:text-gray-100 font-semibold">Custom &amp; business</span>
      </nav>
      <h1 class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-gray-100">Custom &amp; business</h1>
      <p class="mt-4 max-w-3xl text-lg text-gray-600 dark:text-gray-400">
        Need something that isn't in the catalog? We design and print one-off pieces and small batches for people,
        clubs and businesses — priced on quote.
      </p>
      <a
        href={getPermalink(orderPath(custom))}
        class="mt-8 inline-flex items-center justify-center bg-primary hover:bg-primary-dark text-white font-bold py-4 px-8 rounded-lg transition-colors"
      >
        Ask for a quote →
      </a>
    </div>
  </section>

  <section class="py-10 md:py-14 bg-white dark:bg-slate-900">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">
      <h2 class="text-2xl md:text-3xl font-bold text-gray-900 dark:text-gray-100 mb-6">Work we've made</h2>
      <div class="grid grid-cols-2 md:grid-cols-3 gap-3 md:gap-4">
        {
          examples.map((img) => (
            <div class="aspect-square rounded-xl overflow-hidden bg-gray-100 dark:bg-slate-700">
              <Image
                src={img.meta!}
                alt={img.alt}
                class="w-full h-full object-cover"
                widths={[300, 600]}
                sizes="(max-width: 768px) 50vw, 320px"
              />
            </div>
          ))
        }
      </div>

      <h2 class="mt-14 text-2xl md:text-3xl font-bold text-gray-900 dark:text-gray-100 mb-6">What we can make</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {
          ideas.map((idea) => (
            <div class="rounded-xl p-5 bg-gray-50 dark:bg-slate-800 border border-gray-100 dark:border-slate-700">
              <h3 class="font-bold text-gray-900 dark:text-gray-100">{idea.title}</h3>
              <p class="mt-1 text-sm text-gray-600 dark:text-gray-400">{idea.text}</p>
            </div>
          ))
        }
      </div>

      <h2 class="mt-14 text-2xl md:text-3xl font-bold text-gray-900 dark:text-gray-100 mb-6">How it works</h2>
      <ol class="grid grid-cols-1 md:grid-cols-3 gap-4">
        {
          steps.map((step, i) => (
            <li class="rounded-xl p-5 bg-primary/5 dark:bg-primary/10 border border-primary/20">
              <span class="inline-flex items-center justify-center w-8 h-8 rounded-full bg-primary text-white font-bold">{i + 1}</span>
              <h3 class="mt-3 font-bold text-gray-900 dark:text-gray-100">{step.title}</h3>
              <p class="mt-1 text-sm text-gray-600 dark:text-gray-400">{step.text}</p>
            </li>
          ))
        }
      </ol>

      <div class="mt-14 text-center">
        <a
          href={getPermalink(orderPath(custom))}
          class="inline-flex items-center justify-center bg-primary hover:bg-primary-dark text-white font-bold py-4 px-8 rounded-lg transition-colors"
        >
          Ask for a quote →
        </a>
      </div>
    </div>
  </section>
</Layout>
