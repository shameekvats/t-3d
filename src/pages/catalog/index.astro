---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import ProductCard from '~/components/catalog/ProductCard.astro';
import CustomCard from '~/components/catalog/CustomCard.astro';
import { getPermalink } from '~/utils/permalinks';
import { categories, productsInCategory, categoryPath } from '~/data/products';

const metadata = {
  title: 'Catalog — tattva-3d | Custom 3D Printed Products in Luxembourg',
  description: 'Browse our catalog of custom 3D printed products in Luxembourg — keychains, bookmarks, lamps, maps, glow photos and more. Order on demand.',
};
---

<Layout metadata={metadata}>
  <Hero>
    <Fragment slot="title">Products &amp; prices</Fragment>
    <Fragment slot="subtitle">
      Personal 3D printed gifts, made to order. Pick a product, send your photo, text or location, and approve a preview before we print.
    </Fragment>
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-gradient-to-b from-primary/10 to-transparent dark:from-primary/20"></div>
    </Fragment>
  </Hero>

  {
    categories.map((category) => (
      <section id={category.id} class="py-10 md:py-14 bg-white dark:bg-slate-900 scroll-mt-20">
        <div class="max-w-7xl mx-auto px-4 sm:px-6">
          <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-2 mb-6">
            <div>
              <h2 class="text-2xl md:text-3xl font-bold text-gray-900 dark:text-gray-100">{category.name}</h2>
              <p class="text-gray-600 dark:text-gray-400 mt-1">{category.tagline}</p>
            </div>
            <a href={getPermalink(categoryPath(category.id))} class="font-semibold text-primary hover:underline">
              See all {category.name.toLowerCase()} →
            </a>
          </div>
          <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6">
            {productsInCategory(category.id).map((product) => (
              <ProductCard product={product} />
            ))}
          </div>
        </div>
      </section>
    ))
  }

  <section class="pt-4 pb-16 md:pb-20 bg-white dark:bg-slate-900">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <CustomCard />
    </div>
  </section>
</Layout>
