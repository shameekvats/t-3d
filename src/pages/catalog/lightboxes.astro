---
import Layout from '~/layouts/PageLayout.astro';
import { getPermalink } from '~/utils/permalinks';
import { Image } from 'astro:assets';

import cube1 from '~/assets/images/Gallery/lightbox/low_key/Image_1.png';
import cube2 from '~/assets/images/Gallery/lightbox/low_key/Image_2.png';
import cube3 from '~/assets/images/Gallery/lightbox/low_key/Image_3.png';
import cube4 from '~/assets/images/Gallery/lightbox/low_key/Image_4.png';
import logo1 from '~/assets/images/Gallery/lightbox/beyond_music/BM_1.png';
import logo2 from '~/assets/images/Gallery/lightbox/beyond_music/BM_2.png';
import logo3 from '~/assets/images/Gallery/lightbox/beyond_music/BM_3.png';

const metadata = {
  title: 'Custom 3D Lightboxes in Luxembourg — tattva-3d',
  description: 'Custom 3D printed illuminated lightboxes in Luxembourg. Cube lightboxes and logo lightboxes — any photo or design. Contact us for pricing.',
};

const variants = [
  {
    id: 'cube',
    title: 'Cube Lightbox',
    description: 'A 5-sided illuminated cube — any photo, logo, or design on every face. Plugs in and glows on your desk or shelf.',
    images: [cube1, cube2, cube3, cube4],
  },
  {
    id: 'logo',
    title: 'Logo Lightbox',
    description: 'Turn your brand, logo, or any flat design into a glowing backlit display. Perfect for desks, shelves, or window displays.',
    images: [logo1, logo2, logo3],
  },
];
---

<Layout metadata={metadata}>
  <section class="pt-24 pb-12 bg-gradient-to-b from-primary/10 to-transparent dark:from-primary/20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <nav class="mb-6 text-sm">
        <a href={getPermalink('/')} class="text-gray-600 dark:text-gray-400 hover:text-primary">Home</a>
        <span class="mx-2 text-gray-400">/</span>
        <a href={getPermalink('/catalog')} class="text-gray-600 dark:text-gray-400 hover:text-primary">Catalog</a>
        <span class="mx-2 text-gray-400">/</span>
        <span class="text-gray-900 dark:text-gray-100 font-semibold">Lightboxes</span>
      </nav>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-start">
        <div>
          <div class="flex items-center gap-4 mb-6">
            <div class="text-6xl">💡</div>
            <div>
              <h1 class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-gray-100">Lightboxes</h1>
              <p class="text-xl text-gray-600 dark:text-gray-400 mt-2">Custom 3D printed illuminated lightboxes — any photo, logo, or design</p>
            </div>
          </div>

          <div class="grid grid-cols-2 gap-3 mb-6">
            <div class="flex items-center gap-2 text-gray-700 dark:text-gray-300">
              <span class="text-2xl">💡</span><span class="text-sm font-medium">LED Illuminated</span>
            </div>
            <div class="flex items-center gap-2 text-gray-700 dark:text-gray-300">
              <span class="text-2xl">🎨</span><span class="text-sm font-medium">Any Design</span>
            </div>
            <div class="flex items-center gap-2 text-gray-700 dark:text-gray-300">
              <span class="text-2xl">📸</span><span class="text-sm font-medium">Photo or Logo</span>
            </div>
            <div class="flex items-center gap-2 text-gray-700 dark:text-gray-300">
              <span class="text-2xl">🎁</span><span class="text-sm font-medium">Desk or Shelf Display</span>
            </div>
          </div>

          <p class="text-lg text-gray-600 dark:text-gray-400">
            Transform any image or logo into a glowing display piece. Choose a 5-sided illuminated cube for photos or designs on every face, or a flat logo lightbox for branding and décor. Both make unforgettable gifts and conversation pieces.
          </p>
        </div>

        <div class="bg-white dark:bg-slate-800 rounded-2xl shadow-xl p-8 border border-gray-100 dark:border-slate-700">
          <div class="pb-6 mb-6 border-b border-gray-200 dark:border-slate-700">
            <p class="text-xs font-semibold uppercase tracking-widest text-gray-500 dark:text-gray-400 mb-4 text-center">Options</p>
            <div class="space-y-3">
              <div class="px-4 py-3 bg-gray-50 dark:bg-slate-700/50 rounded-lg">
                <span class="text-sm font-medium text-gray-700 dark:text-gray-300">Cube Lightbox</span>
              </div>
              <div class="px-4 py-3 bg-gray-50 dark:bg-slate-700/50 rounded-lg">
                <span class="text-sm font-medium text-gray-700 dark:text-gray-300">Logo Lightbox</span>
              </div>
            </div>
          </div>

          <a
            href="/order?product=lightboxes"
            target="_blank"
            rel="noopener noreferrer"
            class="block w-full text-center bg-primary hover:bg-primary-dark text-white font-bold py-4 px-8 rounded-lg transition-all duration-300 transform hover:scale-105 hover:shadow-lg mb-3"
          >
            Request a Quote →
          </a>

          <p class="text-center text-sm text-gray-500 dark:text-gray-400">
            Questions? <a href="mailto:t-3d@ik.me" class="text-primary hover:underline font-medium">t-3d@ik.me</a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 bg-white dark:bg-slate-900">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <h2 class="text-3xl font-bold text-gray-900 dark:text-gray-100 mb-12">Examples</h2>

      {variants.map((variant) => (
        <div class="mb-16 last:mb-0">
          <div class="mb-6 pb-4 border-b border-gray-100 dark:border-slate-800">
            <h3 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-2">{variant.title}</h3>
            <p class="text-gray-600 dark:text-gray-400">{variant.description}</p>
          </div>
          <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
            {variant.images.map((img, i) => (
              <div class="group relative bg-white dark:bg-slate-800 rounded-xl overflow-hidden shadow-md hover:shadow-2xl transition-all duration-300">
                <div class="relative aspect-square bg-gray-100 dark:bg-slate-700">
                  <Image
                    src={img}
                    alt={`${variant.title} example ${i + 1}`}
                    class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
                    widths={[400, 768]}
                    sizes="(max-width: 768px) 50vw, 300px"
                  />
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}

      <div class="mt-12 bg-gradient-to-r from-primary/10 to-secondary/10 dark:from-primary/20 dark:to-secondary/20 rounded-2xl p-10 text-center">
        <h3 class="text-2xl md:text-3xl font-bold text-gray-900 dark:text-gray-100 mb-4">Create Your Custom Lightbox</h3>
        <p class="text-lg text-gray-600 dark:text-gray-400 mb-6 max-w-2xl mx-auto">
          Share your photo, logo, or idea — we'll turn it into a glowing display piece.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="/order?product=lightboxes"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 bg-primary hover:bg-primary-dark text-white font-bold py-4 px-8 rounded-lg transition-all duration-300 transform hover:scale-105"
          >
            <span>Request a Quote</span>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
          </a>
          <a
            href={getPermalink('/catalog')}
            class="inline-flex items-center justify-center gap-2 border-2 border-gray-300 dark:border-gray-600 hover:border-primary dark:hover:border-primary text-gray-900 dark:text-gray-100 font-bold py-4 px-8 rounded-lg transition-all duration-300"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
            <span>Back to Catalog</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
