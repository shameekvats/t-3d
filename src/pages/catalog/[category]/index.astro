---
import Layout from '~/layouts/PageLayout.astro';
import ProductCard from '~/components/catalog/ProductCard.astro';
import CustomCard from '~/components/catalog/CustomCard.astro';
import { getPermalink } from '~/utils/permalinks';
import { categories, productsInCategory, formatPrice, lowestPrice, type Category } from '~/data/products';

export function getStaticPaths() {
  return categories.map((category) => ({ params: { category: category.id }, props: { category } }));
}

interface Props {
  category: Category;
}

const { category } = Astro.props;
const items = productsInCategory(category.id);

const metadata = {
  title: `${category.name} — tattva-3d`,
  description: `${category.tagline}. Personal 3D printed ${category.name.toLowerCase()} from ${formatPrice(lowestPrice(category.id))}, made to order.`,
};
---

<Layout metadata={metadata}>
  <section class="pt-24 pb-8 md:pb-12 bg-gradient-to-b from-primary/10 to-transparent dark:from-primary/20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <nav class="mb-6 text-sm" aria-label="Breadcrumb">
        <a href={getPermalink('/')} class="text-gray-600 dark:text-gray-400 hover:text-primary">Home</a>
        <span class="mx-2 text-gray-400">/</span>
        <a href={getPermalink('/catalog')} class="text-gray-600 dark:text-gray-400 hover:text-primary">Catalog</a>
        <span class="mx-2 text-gray-400">/</span>
        <span class="text-gray-900 dark:text-gray-100 font-semibold">{category.name}</span>
      </nav>

      <h1 class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-gray-100">{category.name}</h1>
      <p class="text-xl text-gray-600 dark:text-gray-400 mt-2">{category.tagline}</p>
      {category.description && <p class="mt-6 max-w-3xl text-lg text-gray-600 dark:text-gray-400">{category.description}</p>}
      {
        category.howItsMade && (
          <p class="mt-3 max-w-3xl text-sm text-gray-500 dark:text-gray-400">
            <span class="font-semibold">How it's made:</span> {category.howItsMade}
          </p>
        )
      }
    </div>
  </section>

  <section class="py-10 md:py-14 bg-white dark:bg-slate-900">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="grid grid-cols-2 lg:grid-cols-3 gap-4 md:gap-6">
        {items.map((product) => <ProductCard product={product} />)}
      </div>

      <div class="mt-10">
        <CustomCard />
      </div>

      <p class="mt-10 text-center">
        <a href={getPermalink('/catalog')} class="font-semibold text-primary hover:underline">← All products</a>
      </p>
    </div>
  </section>
</Layout>
