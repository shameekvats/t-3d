---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Layout from '~/layouts/PageLayout.astro';
import { findImage } from '~/utils/images';
import { getPermalink } from '~/utils/permalinks';
import heroImage from '~/assets/images/Gallery/maps_cityscapes/1_Lux_Ville.jpg';
import { categories, categoryPath, formatPrice, lowestPrice } from '~/data/products';

const metadata = {
  title: 'tattva-3d — 3D-printed personal gifts in Aalborg',
  ignoreTitleTemplate: true,
  description:
    'Personal 3D printed gifts made to order in Aalborg: photo keychains, magnets, bookmarks, 3D maps, lamps and lightboxes. Preview first, pay at pickup.',
};

const categoryCards = await Promise.all(
  categories.map(async (category) => ({
    category,
    image: category.image ? ((await findImage(category.image.src)) as ImageMetadata | undefined) : undefined,
    imageAlt: category.image?.alt ?? category.name,
    from: formatPrice(lowestPrice(category.id)),
  }))
);

const steps = [
  { title: 'Choose & send', text: 'Pick a product and send your photo, text or location.' },
  { title: 'Approve a preview', text: 'We send you a preview before printing (usually within 1–2 days).' },
  {
    title: 'Pick up & pay',
    text: 'Collect in Aalborg (exact spot agreed by email) and pay with MobilePay or cash. Typical turnaround: 3–5 days.',
  },
];

const btnPrimary =
  'inline-flex items-center justify-center bg-primary hover:bg-primary-dark text-white font-bold py-3.5 px-7 rounded-lg transition-colors';
const btnSecondary =
  'inline-flex items-center justify-center border-2 border-gray-300 dark:border-gray-600 hover:border-primary text-gray-900 dark:text-gray-100 font-bold py-3 px-7 rounded-lg transition-colors';
---

<Layout metadata={metadata}>
  <!-- Hero -->
  <section class="pt-20 md:pt-28 pb-12 md:pb-20 bg-gradient-to-b from-primary/10 to-transparent dark:from-primary/20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">
      <div>
        <h1 class="text-4xl md:text-6xl font-bold leading-tight tracking-tight text-gray-900 dark:text-gray-100">
          Personal 3D-printed gifts, made in Aalborg
        </h1>
        <p class="mt-5 text-lg md:text-xl text-gray-600 dark:text-gray-300">
          Your photos, your places, your ideas — printed to order.
        </p>
        <div class="mt-8 flex flex-col sm:flex-row gap-3">
          <a href={getPermalink('/catalog')} class={btnPrimary}>See products &amp; prices</a>
          <a href={getPermalink('/order')} class={btnSecondary}>Order</a>
        </div>
      </div>
      <div class="rounded-2xl overflow-hidden shadow-2xl bg-gray-100 dark:bg-slate-800">
        <Image
          src={heroImage}
          alt="3D printed multicolour map of Luxembourg City in a wooden frame"
          class="w-full h-auto"
          widths={[400, 768, 1200]}
          sizes="(max-width: 1024px) 100vw, 600px"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>
  </section>

  <!-- Categories -->
  <section class="py-12 md:py-16 bg-white dark:bg-slate-900">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <h2 class="text-3xl font-bold text-gray-900 dark:text-gray-100 mb-6">What we make</h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 md:gap-6">
        {
          categoryCards.map(({ category, image, imageAlt, from }) => (
            <a
              href={getPermalink(categoryPath(category.id))}
              class="group block bg-white dark:bg-slate-800 rounded-xl overflow-hidden shadow-md hover:shadow-xl transition-shadow focus:outline-none focus-visible:ring-2 focus-visible:ring-primary"
            >
              <div class="aspect-[4/3] overflow-hidden bg-gray-100 dark:bg-slate-700">
                {image && (
                  <Image
                    src={image}
                    alt={imageAlt}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    widths={[400, 768]}
                    sizes="(max-width: 640px) 100vw, 33vw"
                  />
                )}
              </div>
              <div class="p-5">
                <h3 class="text-xl font-bold text-gray-900 dark:text-gray-100 group-hover:text-primary transition-colors">
                  {category.name}
                </h3>
                <p class="mt-1 text-sm text-gray-600 dark:text-gray-400">{category.tagline}</p>
                <p class="mt-3 font-semibold text-gray-900 dark:text-gray-100">from {from}</p>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="py-12 md:py-16 bg-gray-50 dark:bg-slate-800/60">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <h2 class="text-3xl font-bold text-gray-900 dark:text-gray-100 mb-6">How it works</h2>
      <ol class="grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-6">
        {
          steps.map((step, i) => (
            <li class="rounded-xl p-6 bg-white dark:bg-slate-900 shadow-sm">
              <span class="inline-flex items-center justify-center w-9 h-9 rounded-full bg-primary text-white font-bold">{i + 1}</span>
              <h3 class="mt-4 text-lg font-bold text-gray-900 dark:text-gray-100">{step.title}</h3>
              <p class="mt-1 text-gray-600 dark:text-gray-400">{step.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Custom & business -->
  <section class="py-12 md:py-16 bg-white dark:bg-slate-900">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <a
        href={getPermalink('/custom')}
        class="group flex flex-col md:flex-row md:items-center md:justify-between gap-4 rounded-2xl p-6 md:p-10 bg-gradient-to-r from-primary/10 to-secondary/10 dark:from-primary/20 dark:to-secondary/20 border-2 border-dashed border-primary/30 hover:border-primary transition-colors"
      >
        <div>
          <h2 class="text-2xl md:text-3xl font-bold text-gray-900 dark:text-gray-100">Custom &amp; business</h2>
          <p class="mt-2 text-gray-600 dark:text-gray-400">
            Branded keychains, logo lightboxes, large multi-tile maps, workshops.
          </p>
        </div>
        <span class="inline-flex items-center gap-2 font-bold text-primary whitespace-nowrap">
          Ask for a quote
          <svg class="w-5 h-5 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
        </span>
      </a>
    </div>
  </section>

  <!-- About -->
  <section class="py-12 md:py-16 bg-gray-50 dark:bg-slate-800/60">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 text-center">
      <h2 class="text-3xl font-bold text-gray-900 dark:text-gray-100 mb-4">About</h2>
      <p class="text-lg text-gray-600 dark:text-gray-300">
        tattva-3d is a one-person studio in Aalborg. Shameek is a materials scientist who designs and prints every piece
        by hand — one at a time, to order.
      </p>
    </div>
  </section>

  <!-- Instagram -->
  <section class="py-12 md:py-16 bg-white dark:bg-slate-900">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 text-center">
      <h2 class="text-2xl md:text-3xl font-bold text-gray-900 dark:text-gray-100">See new prints on Instagram</h2>
      <p class="mt-2 text-gray-600 dark:text-gray-400">Recent work and behind-the-scenes from the printer.</p>
      <a
        href="https://www.instagram.com/tattva_3d/"
        target="_blank"
        rel="noopener noreferrer"
        class="mt-6 inline-flex items-center gap-2 px-7 py-3 bg-gradient-to-r from-purple-500 to-pink-500 hover:from-purple-600 hover:to-pink-600 text-white font-semibold rounded-lg transition-colors"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <rect x="3" y="3" width="18" height="18" rx="5" />
          <circle cx="12" cy="12" r="4" />
          <circle cx="17.5" cy="6.5" r="0.5" fill="currentColor" />
        </svg>
        Follow @tattva_3d
      </a>
    </div>
  </section>
</Layout>
